@page "/contrato"
@inherits ListarContratoPage

<MudText Typo="Typo.h3">Contratos</MudText>

<div class="d-flex justify-end">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.TwoTone.Add"
               Href="/contrato/adicionar">
        NOVO CONTRATO
    </MudButton>
</div>

<MudDataGrid class="mt-4"
             Items="@Contratos"
             Filterable="true"
             QuickFilter="Filter"
             Hideable="true">
    <ToolBarContent>
        <MudTextField @bind-Value="SearchTerm"
                      Placeholder="Filtrar..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="#" />
        <PropertyColumn Property="x => x.Paciente.Nome" Title="Paciente" />
        <PropertyColumn Property="x => x.Responsavel.Nome" Title="Responsável" />
        <PropertyColumn Property="x => x.DataEmissao" Title="Dt. emissão" Format="dd/MM/yyyy" />
        <PropertyColumn Property="x => x.Situacao" Title="Situação" />
        <PropertyColumn Property="x => x.ValorContrato" Title="Valor do contrato" Format="C" />
        <TemplateColumn Class="d-flex justify-end">
            <CellTemplate>
                <MudStack Row>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Href="@($"/contrato/editar/{context.Item.Id}")"
                                   Color="Color.Primary">
                    </MudIconButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   arial-label="Excluir"
                                   OnClick="() => OnDeleteButtonClickedAsync(context.Item.Id, context.Item.Paciente.Nome, context.Item.Responsavel.Nome)">
                    </MudIconButton>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>