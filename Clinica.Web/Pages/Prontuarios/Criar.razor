@page "/prontuario/adicionar"
@inherits CriarProntuarioPage

<MudText Typo="Typo.h3">Cadastrar novo prontuário</MudText>
<MudPaper Class="pa-8 mt-4">
    <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />

        <MudDatePicker @bind-Date="InputModel.DataProntuario"
                       Label="Data do prontuário"
                       Required="true"
                       For="@(() => InputModel.DataProntuario)"
                       HelperText="Selecione a data do prontuário" />

        <MudSelect T="long"
                   Label="Contrato"
                   @bind-Value="InputModel.ContratoId"
                   Required="true"
                   For="@(() => InputModel.ContratoId)"
                   AnchorOrigin="Origin.BottomCenter">
            @foreach (var contrato in Contratos)
            {
                <MudSelectItem T="long" Value="@contrato.Id">@contrato.Paciente.Nome</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="long"
                   Label="Profissional"
                   @bind-Value="InputModel.ProfissionalId"
                   Required="true"
                   For="@(() => InputModel.ProfissionalId)"
                   AnchorOrigin="Origin.BottomCenter">
            @foreach (var profissional in Profissionais)
            {
                <MudSelectItem T="long" Value="@profissional.Id">@profissional.Nome</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Clinica.Core.Enums.ECobranca"
                   Label="Cobrança"
                   @bind-Value="InputModel.Cobranca"
                   Required="true"
                   For="@(() => InputModel.Cobranca)"
                   AnchorOrigin="Origin.BottomCenter">
            <MudSelectItem T="Clinica.Core.Enums.ECobranca" Value="Clinica.Core.Enums.ECobranca.Sim">Sim</MudSelectItem>
            <MudSelectItem T="Clinica.Core.Enums.ECobranca" Value="Clinica.Core.Enums.ECobranca.Nao">Não</MudSelectItem>
        </MudSelect>

        <MudTextField Label="Descrição"
                      MaxLength="8000"
                      Counter="300"
                      @bind-Value="InputModel.Descricao"
                      For="@(() => InputModel.Descricao)" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-4">Salvar</MudButton>
    </EditForm>
</MudPaper>