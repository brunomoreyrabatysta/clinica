@page "/financeiro/editar/{id}"
@inherits EditarFinanceiroPage

<MudText Typo="Typo.h3">Editar Financeiro</MudText>

@if (IsBusy)
{
    <MudPaper Class="pa-8 mt-4">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Info" />
    </MudPaper>
}
else
{
    <MudPaper Class="pa-8 mt-4">
        <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudSelect T="long"
                       Label="Contrato"
                       @bind-Value="InputModel.ContratoId"
                       Required="true"
                       For="@(() => InputModel.ContratoId)"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var contrato in Contratos)
                {
                    <MudSelectItem T="long" Value="@contrato.Id">@contrato.Paciente.Nome - @contrato.Responsavel.Nome</MudSelectItem>
                }
            </MudSelect>

            <MudTextField Label="Data de emissão"
                          HelperText="Campo obrigatório"
                          MaxLength="300"
                          Counter="300"
                          Required="true"
                          @bind-Value="InputModel.DataEmissao"
                          For="@(() => InputModel.DataEmissao)" />

            <MudTextField Label="Data de vencimento"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.DataVencimento"
                          For="@(() => InputModel.DataVencimento)" />

            <MudTextField Label="Data de pagamento"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.DataPagamento"
                          For="@(() => InputModel.DataPagamento)" />

            <MudTextField Label="Data de cancelamento"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.DataCancelamento"
                          For="@(() => InputModel.DataCancelamento)" />

            <MudSelect T="Clinica.Core.Enums.ESituacaoFinanceiro"
                       Label="Situação"
                       @bind-Value="InputModel.Situacao"
                       Required="true"
                       For="@(() => InputModel.Situacao)"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="Clinica.Core.Enums.ESituacaoFinanceiro" Value="Clinica.Core.Enums.ESituacaoFinanceiro.Aberto">Aberto</MudSelectItem>
                <MudSelectItem T="Clinica.Core.Enums.ESituacaoFinanceiro" Value="Clinica.Core.Enums.ESituacaoFinanceiro.Pago">Pago</MudSelectItem>
                <MudSelectItem T="Clinica.Core.Enums.ESituacaoFinanceiro" Value="Clinica.Core.Enums.ESituacaoFinanceiro.Cancelado">Cancelado</MudSelectItem>
            </MudSelect>

            <MudTextField Label="Valor"
                          HelperText="Campo obrigatório"
                          Required="true"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.Valor"
                          For="@(() => InputModel.Valor)" />

            <MudTextField Label="Valor de mora"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.ValorMora"
                          For="@(() => InputModel.ValorMora)" />

            <MudTextField Label="Valor de juros"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.ValorJuros"
                          For="@(() => InputModel.ValorJuros)" />

            <MudTextField Label="Valor do desconto"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.ValorDesconto"
                          For="@(() => InputModel.ValorDesconto)" />

            <MudTextField Label="Valor pago"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.ValorPago"
                          For="@(() => InputModel.ValorPago)" />

            <MudTextField Label="Número da parcela"
                          MaxLength="300"
                          Counter="300"
                          @bind-Value="InputModel.NumeroParcela"
                          For="@(() => InputModel.NumeroParcela)" />

            <MudSelect T="Clinica.Core.Enums.ETipoFinanceiro"
                       Label="Tipo do financeiro"
                       @bind-Value="InputModel.TipoFinanceiro"
                       Required="true"
                       For="@(() => InputModel.TipoFinanceiro)"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="Clinica.Core.Enums.ETipoFinanceiro" Value="Clinica.Core.Enums.ETipoFinanceiro.Mensalidade">Mensalidade</MudSelectItem>
                <MudSelectItem T="Clinica.Core.Enums.ETipoFinanceiro" Value="Clinica.Core.Enums.ETipoFinanceiro.Avulso">Avulso</MudSelectItem>
            </MudSelect>

            <MudSelect T="Clinica.Core.Enums.ETipoCredito"
                       Label="Tipo de crédito"
                       @bind-Value="InputModel.TipoCredito"
                       Required="true"
                       For="@(() => InputModel.TipoCredito)"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="Clinica.Core.Enums.ETipoCredito" Value="Clinica.Core.Enums.ETipoCredito.Credito">Crédito</MudSelectItem>
                <MudSelectItem T="Clinica.Core.Enums.ETipoCredito" Value="Clinica.Core.Enums.ETipoCredito.Debito">Débito</MudSelectItem>
            </MudSelect>

            <MudTextField Label="Observação"
                          MaxLength="8000"
                          Counter="300"
                          @bind-Value="InputModel.Observacao"
                          For="@(() => InputModel.Observacao)" />



            <div class="d-flex mt-8">
                @if (IsBusy)
                {
                    <MudProgressCircular Color="Color.Info" Indeterminate="true" />
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">
                        Salvar
                    </MudButton>
                }
            </div>
        </EditForm>
    </MudPaper>
}